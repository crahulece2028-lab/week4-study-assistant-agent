# Copy this file to .env and fill in what you have. Everything is optional:
# with no keys the app runs offline using a deterministic extractive LLM and a
# local tracer, which is enough to exercise the whole graph and the evaluation.

# --- LLM provider (pick one; Groq is preferred, it is fastest on the free tier) ---
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# --- LangSmith tracing and evaluation ---
# https://smith.langchain.com  ->  Settings -> API keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=week4-study-assistant

# --- Retrieval knobs (overridden by CLI flags where offered) ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
